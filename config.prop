# ==============================================================================
# AOD 全天候壁纸显示与防烧屏省电配置文件
# 版本: v1.0 (小米 15 专版 · Apple-Style 防烧屏 · 1Hz LTPO)
# 作者: Cheese | GitHub: Cheese-nya
# 提示: 修改本文件后系统将在 5 秒内自动热重载生效，无需重启！
# ==============================================================================

# 1. 息屏壁纸总开关 (1: 开启全天候壁纸, 0: 传统纯黑AOD)
AOD_WALLPAPER_ENABLE=1

# 2. 息屏模糊滤镜可选项 (0: 默认灰色滤镜/清晰无模糊, 1: 启用高斯模糊滤镜)
#    * 默认值 0：呈现原生清晰、锐利的 iOS 哑光深灰质感，彻底消除毛玻璃模糊！
#    * 设置为 1：在息屏壁纸上叠加窗口高斯模糊滤镜。
AOD_BLUR_FILTER=0

# 3. AOD 刷新率模式 (1: 强制 1Hz 极限省电, 30: 30Hz平衡防闪烁, 60: 60Hz原生兼容)
AOD_REFRESH_RATE=1

# 4. 解除系统全局最小刷新率锁定 (1: 开启/允许降至1Hz, 0: 保持系统默认)
AOD_UNLOCK_MIN_FPS=1